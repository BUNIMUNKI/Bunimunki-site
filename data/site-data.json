                                       ]
                       },
                       {
                           "name":  "Sedna",
                           "role":  "Wildcard",
                           "bio":  "Sedna adds chaos to every small errand. She treats questionable ideas like they are completely normal, which makes her either the funniest or most dangerous person in the room.",
                           "image":  "assets/sedna/sednawarp.gif",
                           "profileImage":  "assets/sedna/profile.png",
