                                       ]
                       },
                       {
                           "name":  "Glepglorp (GG)",
                           "role":  "Lazy Cat",
                           "bio":  "GG is a lazy little brat who can be annoying at times, always dodging effort and stirring up nonsense. But she is so cute that everyone usually lets it slide.",
                           "image":  "assets/gg/warpzonegg.gif",
