                           "gallery":  [
                                           "assets/gg/profile.png"
                                       ]
                       },
                       {
                           "name":  "Bebe",
                           "role":  "Rival",
                           "bio":  "Bebe is Lydia\u0027s rival: competitive, sharp-tongued, and always one step ahead. She thrives on testing Lydia\u0027s patience and proving she\u0027s the better planner.",
