    "characters":  [
                       {
                           "name":  "Lydia",
                           "role":  "Operative",
                           "bio":  "Lydia is the one trying to keep everyone on track, even when the plan is already falling apart. She is sharp, stubborn, and usually the first to realize the situation has gotten ridiculous.",
